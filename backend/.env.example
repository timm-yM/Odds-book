# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local: mongodb://127.0.0.1:27017/oddsbook
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oddsbook
MONGO_URI=mongodb://127.0.0.1:27017/oddsbook

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:5173

# --- Public URL of this API (the payment gateway sends results here) ---
# Local testing needs a tunnel (e.g. ngrok) - or leave it and rely on status polling.
# Production: your Render URL, e.g. https://oddsbook-api.onrender.com
API_URL=http://localhost:5000

# --- M-Pesa payments (leave the keys blank to run paid checkout in demo/instant-unlock mode) ---
# Which gateway to use: pesaflux (default) or payhero
PAYMENT_PROVIDER=pesaflux

# PesaFlux - dashboard -> Linked Accounts -> API Key (and the email you log in with)
PESAFLUX_API_KEY=
PESAFLUX_EMAIL=

# Any long random string. Add it to the webhook URL you give your gateway:
#   https://<your-api>.onrender.com/api/payments/webhook?token=<this value>
PAYMENT_WEBHOOK_SECRET=

# Only if PAYMENT_PROVIDER=payhero
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=


# Percentage ODDSBOOK keeps from each paid pick sold
PLATFORM_FEE_PERCENT=15

# --- Master admin account (used by `npm run seed:admin`) ---
ADMIN_NAME=ODDSBOOK Admin
ADMIN_EMAIL=admin@oddsbook.com
ADMIN_PASSWORD=change-this-password
